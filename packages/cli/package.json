{
  "name": "@fiber-pay/cli",
  "version": "0.2.3",
  "description": "Command-line tool for managing Fiber Network nodes",
  "type": "module",
  "bin": {
    "fiber-pay": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "error-codes.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ckb",
    "lightning",
    "fiber",
    "cli",
    "nervos"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fiber-pay/node": "workspace:*",
    "@fiber-pay/runtime": "workspace:*",
    "@fiber-pay/sdk": "workspace:*",
    "commander": "^13.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "qrcode": "^1.5.4",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6"
  }
}
