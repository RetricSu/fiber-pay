{
  "name": "@fiber-pay/react",
  "version": "0.3.0",
  "description": "React hooks and components for Fiber browser payments",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "keywords": [
    "fiber",
    "ckb",
    "react",
    "passkey",
    "wasm",
    "payment"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "@fiber-pay/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "qrcode.react": "^4.0.0",
    "@nervosnetwork/fiber-js": "~0.8.1"
  },
  "peerDependenciesMeta": {
    "qrcode.react": {
      "optional": true
    },
    "@nervosnetwork/fiber-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nervosnetwork/fiber-js": "~0.8.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "jsdom": "^26.1.0"
  }
}
